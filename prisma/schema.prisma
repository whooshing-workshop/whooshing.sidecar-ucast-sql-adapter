generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model TestUser {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String      @unique
  metadata  Json        @default("{}")
  status    String
  UserStats UserStats[]
}

model UserStats {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @db.Uuid
  loginCount  Int?     @default(0)
  preferences Json?    @default("{\"theme\": \"dark\"}")
  TestUser    TestUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
